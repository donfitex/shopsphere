@{
    ViewData["Title"] = "ShopSphere - Home";
}

<section class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center">
        
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold">Welcome to ShopSphere</h1>

                <p class="lead mt-3">
                    Discover quality products at competitive prices.
                    Shop conveniently and have your orders delivered
                    to your doorstep.
                </p>

                <a asp-controller="Products"
                    asp-action="Index"
                    class="btn btn-warning btn-lg mt-3">
                    Show Now
                </a>
            </div>

            @* <div class="col-lg-5 text-center mt-4 mt-lg-0">
                <div class="hero-placeholder">
                    <span>ShopSphere</span>
                </div>
            </div> *@

        </div>
    </div>
</section>

<section class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Featured Products</h2>

        <a asp-controller="Products"
            asp-action="Index"
            class="text-decoration-none">
            View All
        </a>
    </div>

    <div class="row q-4">
        <div class="col-12" col-sm-6 col-lg-3>
            <div class="card h-100">
                <div class="product-placeholder">
                    Product Image
                </div>

                <div class="card-body">
                    <h5 class="card-title">
                        Sample Product
                    </h5>

                    <p class="card-text text-muted">
                        Product description goes here.
                    </p>

                    <p class="fw-bold">
                        #25,000
                    </p>

                    <button class="btn btn-outline-dark w-100" type="button" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>